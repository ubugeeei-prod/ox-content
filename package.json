{
  "name": "ox-content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "vp run workspace:fmt",
    "fmt:check": "vp run workspace:fmt:check",
    "check": "vp run workspace:check",
    "check:file-lines": "node tools/scripts/check-file-lines.ts",
    "lint": "vp run workspace:lint",
    "test": "vp run workspace:test",
    "build": "vp run workspace:build",
    "dev": "vp run workspace:dev",
    "ci": "vp run workspace:ci",
    "issue-agent": "node tools/scripts/issue-agent.mjs",
    "ready": "vp run workspace:ready",
    "release": "vp run workspace:release"
  },
  "devDependencies": {
    "@ox-content/vite-plugin": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.1.0"
}
