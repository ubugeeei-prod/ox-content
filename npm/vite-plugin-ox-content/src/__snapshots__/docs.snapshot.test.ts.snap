<span class="line"><span style="color:var(--octc-syntax-foreground, #e6edf3)">  </span><span style="color:var(--octc-syntax-token-punctuation, #c9d1d9)">}</span><span style="color:var(--octc-syntax-token-punctuation, #c9d1d9)">,</span></span>
<span class="line"><span style="color:var(--octc-syntax-token-punctuation, #c9d1d9)">}</span><span style="color:var(--octc-syntax-token-punctuation, #c9d1d9)">)</span><span style="color:var(--octc-syntax-token-punctuation, #c9d1d9)">;</span></span>
