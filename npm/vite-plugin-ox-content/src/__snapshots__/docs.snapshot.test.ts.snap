<pre class="ox-highlight css-variables" style="background-color:var(--octc-syntax-background, #0d1117);color:var(--octc-syntax-foreground, #e6edf3)" tabindex="0" data-language="md"><code class="language-md" data-language="md"><span class="line"><span style="color:var(--octc-syntax-token-punctuation, #c9d1d9)">\`\`\`</span><span style="color:var(--octc-syntax-token-string, #a5d6ff)">ts markers=&quot;highlight:2;warning:3&quot;</span></span>
