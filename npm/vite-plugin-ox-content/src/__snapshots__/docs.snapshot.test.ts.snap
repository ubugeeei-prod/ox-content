<span class="line"><span style="color:var(--octc-syntax-foreground, #e6edf3)">refreshToken(token</span><span style="color:var(--octc-syntax-token-string, #a5d6ff)">);</span></span>
<span class="line"><span style="color:var(--octc-syntax-foreground, #e6edf3)">console.warn(&quot;Token</span><span style="color:var(--octc-syntax-token-string, #a5d6ff)"> </span><span style="color:var(--octc-syntax-foreground, #e6edf3)">expires</span><span style="color:var(--octc-syntax-token-string, #a5d6ff)"> </span><span style="color:var(--octc-syntax-foreground, #e6edf3)">soon</span><span style="color:var(--octc-syntax-token-string, #a5d6ff)">&quot;);</span></span>
<span class="line"><span style="color:var(--octc-syntax-token-punctuation, #c9d1d9)">\`\`\`</span></span>
