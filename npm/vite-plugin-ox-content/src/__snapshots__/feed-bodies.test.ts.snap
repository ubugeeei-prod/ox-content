exports[`feed bodies > renders the Atom body 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Docs &amp; Co &lt;x&gt;</title>
  <link href="https://example.com/atom.xml" rel="self"/>
  <link href="https://example.com/" rel="alternate"/>
  <id>https://example.com/</id>
  <updated>2024-01-02T03:04:05Z</updated>
  <subtitle>Example docs</subtitle>
  <entry>
    <title>Plain</title>
    <link href="https://example.com/a"/>
    <id>https://example.com/a</id>
    <updated>2024-01-02T03:04:05Z</updated>
    <summary>desc</summary>
  </entry>
  <entry xml:lang="ja">
    <title>Rich &amp; &lt;escaped&gt;</title>
    <link href="https://example.com/b"/>
    <id>urn:custom:b</id>
    <updated>2023-06-07T08:09:10Z</updated>
    <summary>short summary</summary>
    <content type="text">the full body
with a newline</content>
    <author>
      <name>Jane &lt;j&gt;</name>
    </author>
    <author>
      <name>Kim</name>
      <uri>https://example.com/kim</uri>
    </author>
    <link rel="enclosure" href="https://example.com/a.mp3" type="audio/mpeg" length="1234"/>
    <link rel="enclosure" href="https://example.com/b.png" title="Cover"/>
  </entry>
  <entry>
    <title>ContentOnly</title>
    <link href="https://example.com/c"/>
    <id>https://example.com/c</id>
    <updated>2022-02-02T00:00:00Z</updated>
    <content type="text">body only</content>
  </entry>
  <entry>
    <title>NoDate</title>
    <link href="https://example.com/d"/>
    <id>https://example.com/d</id>
    <updated>2024-01-02T03:04:05Z</updated>
    <summary>no date</summary>
  </entry>
</feed>
"
`;

